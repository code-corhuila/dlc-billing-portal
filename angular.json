{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dlc-billing-portal": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "dlc",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": { "target": "dlc-billing-portal:build-original:production" },
          "configurations": {
            "production": { "target": "dlc-billing-portal:build-original:production" },
            "development": { "target": "dlc-billing-portal:build-original:development", "dev": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": { "target": "dlc-billing-portal:serve-original:development", "dev": true }
        },
        "build-original": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dlc-billing-portal",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": []
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "dlc-billing-portal:build-original:development", "port": 4204 }
        }
      }
    }
  }
}
