{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dlc-billing-portal": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "dlc",
      "architect": {
        "build-portal": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/portal-entry.ts",
            "tsConfig": "tsconfig.app.json",
            "outputPath": { "base": "dist/billing-composition", "browser": "" },
            "index": false,
            "polyfills": [],
            "assets": [],
            "styles": [],
            "optimization": true,
            "outputHashing": "none"
          }
        },
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "dlc-billing-portal:build-original:production"
          },
          "configurations": {
            "production": {
              "target": "dlc-billing-portal:build-original:production"
            },
            "development": {
              "target": "dlc-billing-portal:build-original:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "dlc-billing-portal:serve-original:development",
            "dev": true
          }
        },
        "build-original": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dlc-billing-portal",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "es-module-shims"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4204
          },
          "configurations": {
            "development": {
              "buildTarget": "dlc-billing-portal:build-original:development"
            },
            "production": {
              "buildTarget": "dlc-billing-portal:build-original:production"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "662831e1-244e-4d61-9dec-77efdc37d5b6"
  }
}
